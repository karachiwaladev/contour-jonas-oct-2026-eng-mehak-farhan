{
  "permissions": {
    "ask": [
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(gh api *pulls/*/merge*)",
      "PowerShell(gh api *pulls/*/merge*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(rm -rf*)",
      "Bash(rm -r *)",
      "Bash(gh repo delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh release delete*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh issue delete*)",
      "PowerShell(gh release delete*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/on-stop.sh\"",
            "timeout": 90,
            "statusMessage": "Logging prompts and auto-committing"
          }
        ]
      }
    ]
  }
}
