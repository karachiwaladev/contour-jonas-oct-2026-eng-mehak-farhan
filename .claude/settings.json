{
  "permissions": {
    "ask": [
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(gh api *pulls/*/merge*)",
      "PowerShell(gh api *pulls/*/merge*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -r *)",
      "Bash(rm -R *)",
      "Bash(git push --force-with-lease*)",
      "Bash(curl * | sh*)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sudo *)",
      "Bash(wget * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(wget * | sudo *)",
      "Bash(bash <(curl *)",
      "Bash(cat .env*)",
      "Bash(cat */.env*)",
      "Bash(source .env*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "PowerShell(iwr * | iex*)",
      "PowerShell(irm * | iex*)",
      "PowerShell(Invoke-WebRequest * | Invoke-Expression*)",
      "PowerShell(Invoke-RestMethod * | Invoke-Expression*)",
      "PowerShell(iex *)",
      "PowerShell(Invoke-Expression *)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(cat *.env*)",
      "PowerShell(type *.env*)",
      "Bash(gh repo delete*)",
      "Bash(gh issue delete*)",
      "Bash(gh release delete*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh issue delete*)",
      "PowerShell(gh release delete*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-commands.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/on-stop.sh\"",
            "timeout": 90,
            "statusMessage": "Logging prompts and auto-committing"
          }
        ]
      }
    ]
  }
}
