{
  "module": "recurrence.js",
  "description": "Golden edge cases for recurring tasks. Must stay at 100%. Add every recurrence bug that gets fixed.",
  "cases": [
    { "id": "daily-next-day", "fn": "nextDue", "args": ["2026-10-26T18:00", "daily", { "$date": "2026-10-26T12:00" }], "expect": "2026-10-27T18:00", "why": "basic daily repeat keeps the time" },
    { "id": "weekly-next-week", "fn": "nextDue", "args": ["2026-10-26T09:30", "weekly", { "$date": "2026-10-26T08:00" }], "expect": "2026-11-02T09:30", "why": "basic weekly repeat" },
    { "id": "monthly-jan31-clamps-to-feb28", "fn": "nextDue", "args": ["2026-01-31T10:00", "monthly", { "$date": "2026-01-31T09:00" }], "expect": "2026-02-28T10:00", "why": "month-end clamping" },
    { "id": "monthly-leap-year-feb29", "fn": "nextDue", "args": ["2028-01-31T10:00", "monthly", { "$date": "2028-01-31T09:00" }], "expect": "2028-02-29T10:00", "why": "leap year" },
    { "id": "monthly-no-drift-after-clamp", "fn": "nextDue", "args": ["2026-01-31T10:00", "monthly", { "$date": "2026-03-01T09:00" }], "expect": "2026-03-31T10:00", "why": "catch-up keeps the original day (Jan 31 -> Mar 31, not Mar 28)" },
    { "id": "monthly-december-to-january", "fn": "nextDue", "args": ["2026-12-15T07:00", "monthly", { "$date": "2026-12-15T06:00" }], "expect": "2027-01-15T07:00", "why": "year rollover" },
    { "id": "daily-new-years-eve", "fn": "nextDue", "args": ["2026-12-31T20:00", "daily", { "$date": "2026-12-31T10:00" }], "expect": "2027-01-01T20:00", "why": "year rollover" },
    { "id": "weekly-catch-up-skips-overdue", "fn": "nextDue", "args": ["2026-10-05T09:00", "weekly", { "$date": "2026-10-26T12:00" }], "expect": "2026-11-02T09:00", "why": "a task due 3 weeks ago must not create an overdue occurrence" },
    { "id": "no-due-date-one-period-from-now", "fn": "nextDue", "args": [null, "daily", { "$date": "2026-10-26T12:34" }], "expect": "2026-10-27T12:34", "why": "recurring task without a due date" },
    { "id": "invalid-stored-due-never-throws", "fn": "nextDue", "args": ["garbage", "daily", { "$date": "2026-10-26T12:34" }], "expect": "2026-10-27T12:34", "why": "threat model #4: corrupted stored date" },
    { "id": "catch-up-is-capped", "fn": "nextDue", "args": ["1900-01-01T00:00", "daily", { "$date": "2026-10-26T12:00" }], "expect": "2026-10-27T12:00", "why": "threat model #3: no runaway loop on absurd dates" },
    { "id": "non-recurring-has-no-next-due", "fn": "nextDue", "args": ["2026-10-26T18:00", "none", { "$date": "2026-10-26T12:00" }], "expect": null, "why": "repeat none" },
    { "id": "tampered-repeat-string", "fn": "normalizeRepeat", "args": ["hourly"], "expect": "none", "why": "threat model #2: allowlist" },
    { "id": "tampered-repeat-object", "fn": "normalizeRepeat", "args": [{ "daily": true }], "expect": "none", "why": "threat model #2: non-string values" },
    { "id": "completed-non-recurring-spawns-nothing", "fn": "nextOccurrence", "args": [{ "title": "x", "done": true, "due": null, "tags": [], "repeat": "none", "spawnedNext": false }, { "$date": "2026-10-26T12:00" }], "expect": null, "why": "only recurring tasks spawn" },
    { "id": "already-spawned-no-duplicate", "fn": "nextOccurrence", "args": [{ "title": "x", "done": true, "due": null, "tags": [], "repeat": "daily", "spawnedNext": true }, { "$date": "2026-10-26T12:00" }], "expect": null, "why": "rapid re-tick duplicate bug (found by auto-review on PR #13)" },
    { "id": "completed-daily-spawns-next", "fn": "nextOccurrence", "args": [{ "title": "Water plants", "done": true, "due": "2026-10-26T18:00", "tags": ["home"], "repeat": "daily", "spawnedNext": false }, { "$date": "2026-10-26T12:00" }], "expect": { "title": "Water plants", "due": "2026-10-27T18:00", "tags": ["home"], "repeat": "daily" }, "why": "next occurrence copies title, tags and repeat" }
  ]
}
